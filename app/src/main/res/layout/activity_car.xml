<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <SurfaceView
        android:id="@+id/display_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/car_left_app"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="Trái ▼" />

        <Button
            android:id="@+id/car_right_app"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="Phải ▼" />
    </LinearLayout>

    <TextView
        android:id="@+id/car_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="62dp"
        android:background="#99000000"
        android:paddingLeft="12dp"
        android:paddingTop="6dp"
        android:paddingRight="12dp"
        android:paddingBottom="6dp"
        android:text="VF6 Launcher đang kết nối..."
        android:textColor="#FFFFFF"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="10dp"
        android:background="#BB111318"
        android:orientation="horizontal"
        android:padding="4dp">

        <Button
            android:id="@+id/car_back"
            android:layout_width="64dp"
            android:layout_height="48dp"
            android:text="←" />

        <Button
            android:id="@+id/car_home"
            android:layout_width="74dp"
            android:layout_height="48dp"
            android:text="Home" />

        <Button
            android:id="@+id/car_ratio"
            android:layout_width="80dp"
            android:layout_height="48dp"
            android:text="50/50" />

        <Button
            android:id="@+id/car_swap"
            android:layout_width="74dp"
            android:layout_height="48dp"
            android:text="Swap" />

        <Button
            android:id="@+id/car_stop"
            android:layout_width="74dp"
            android:layout_height="48dp"
            android:text="Stop" />
    </LinearLayout>

</FrameLayout>
